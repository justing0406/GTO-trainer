{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gto-trainer",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-08-28",
  "workers_dev": true,
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
